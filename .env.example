# Docker Compose 本地开发配置。复制为 .env 后按需修改；不得提交真实密钥。

MYSQL_ROOT_PASSWORD=local_root_password_change_me
MYSQL_DATABASE=charging_analytics
MYSQL_WRITER_USER=charge_writer
MYSQL_WRITER_PASSWORD=local_writer_password_change_me
MYSQL_READER_USER=charge_reader
MYSQL_READER_PASSWORD=local_reader_password_change_me
MYSQL_PORT=3306

SQLBOT_PORT=8000

# Optional Redis short-term memory. MySQL remains the source of truth.
REDIS_PORT=6379
CHARGE_REDIS_ENABLED=false
CHARGE_REDIS_HOST=localhost
CHARGE_REDIS_PORT=6379
CHARGE_MEMORY_HISTORY_LIMIT=12
CHARGE_MEMORY_TTL_HOURS=24

# Java Agent 使用百炼 OpenAI 兼容接口；真实 Key 仅写入本地 .env。
CHARGE_AI_API_KEY=
# Spring AI appends /v1/chat/completions; do not add /v1 here.
CHARGE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
CHARGE_AI_MODEL=qwen-plus
